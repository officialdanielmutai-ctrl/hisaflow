generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
}

datasource db {
  provider   = "postgresql"
}

// ── Organizations (Tenants) ─────────────────────────────────────

model Organization {
  id           String   @id @default(cuid())
  name         String
  businessType String   @map("business_type")
  currency     String   @default("KES")
  country      String   @default("KE")
  phone        String?
  inviteCode   String?  @unique @map("invite_code")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users                 OrgMembership[]
  products              Product[]
  inventoryItems        InventoryItem[]
  transactions          InventoryTransaction[]
  alerts                Alert[]
  businessTransactions  BusinessTransaction[]
  notes                 Note[]
  creditRecords         CreditRecord[]

  // ── Guest House relations ────────────────────────────────────
  rooms                 Room[]
  guests                Guest[]
  bookings              Booking[]
  invoices              Invoice[]
  @@map("organizations")
}

// ── Users ───────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique @map("clerk_id")
  email     String?  @unique
  phone     String?  @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships        OrgMembership[]
  pushSubscriptions  PushSubscription[]
  notes              Note[]

  @@map("users")
}

// ── Org Membership (User <-> Organization with role) ────────────

enum OrgRole {
  OWNER
  MANAGER
  STAFF
}

model OrgMembership {
  id             String      @id @default(cuid())
  userId         String      @map("user_id")
  organizationId String      @map("organization_id")
  role           OrgRole     @default(STAFF)
  createdAt      DateTime    @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@map("org_memberships")
}

// ── Inventory Items ─────────────────────────────────────────────

enum StockStatus {
  HEALTHY
  LOW
  CRITICAL
  OUT_OF_STOCK
}

enum CatalogSource {
  MANUAL
  OCR
  OPEN_FOOD_FACTS
  UPC_ITEM_DB
}

// Cross-org shared product lookup table. Deliberately has no relation to
// Organization: entries are anonymous, aggregate knowledge ("this barcode
// = this product") contributed by whichever org first records it, so any
// other org scanning the same barcode later gets an instant match without
// an external API call. Not a source of per-org data like pricing.
model ProductCatalogEntry {
  id            String        @id @default(cuid())
  barcode       String        @unique
  name          String
  brand         String?
  category      String?
  unit          String?
  imageUrl      String?       @map("image_url")
  source        CatalogSource @default(MANUAL)
  confirmations Int           @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("product_catalog_entries")
}

model Product {
  id               String          @id @default(cuid())
  organizationId   String          @map("organization_id")
  name             String
  category         String?
  description      String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  organization     Organization    @relation(fields: [organizationId], references: [id])
  variants         InventoryItem[]

  @@index([organizationId])
  @@map("products")
}

model InventoryItem {
  id               String      @id @default(cuid())
  organizationId   String      @map("organization_id")
  productId        String?     @map("product_id")
  name             String
  category         String?
  unit             String      @default("units")
  measureValue     Decimal?    @map("measure_value") @db.Decimal(12, 3)
  measureUnit      String?     @map("measure_unit")
  quantity         Decimal     @default(0) @db.Decimal(12, 3)
  reorderThreshold Decimal?    @map("reorder_threshold") @db.Decimal(12, 3)
  costPrice        Decimal?    @map("cost_price") @db.Decimal(12, 2)
  sellingPrice     Decimal?    @map("selling_price") @db.Decimal(12, 2)
  barcode          String?     @map("barcode")
  status           StockStatus @default(HEALTHY)
  isActive         Boolean     @default(true) @map("is_active")
  
  // Business specific fields
  expiryDate       DateTime?   @map("expiry_date")
  serialNumber     String?     @map("serial_number")
  batchNumber      String?     @map("batch_number")

  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id])
  product      Product?              @relation(fields: [productId], references: [id])
  transactions InventoryTransaction[]
  alerts       Alert[]               // <-- added
  packaging    PackagingUnit[]

  @@index([organizationId])
  @@index([productId])
  @@index([organizationId, status])
  @@index([organizationId, barcode])
  @@map("inventory_items")
}

model PackagingUnit {
  id               String      @id @default(cuid())
  variantId        String      @map("variant_id")
  name             String      // E.g., "Box of 100"
  quantityPerUnit  Int         @map("quantity_per_unit") // e.g., 100
  barcode          String?
  costPrice        Decimal?    @map("cost_price") @db.Decimal(12, 2)
  sellingPrice     Decimal?    @map("selling_price") @db.Decimal(12, 2)

  variant          InventoryItem @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("packaging_units")
}

// ── Inventory Transactions (append-only ledger) ─────────────────

enum TransactionType {
  SALE
  PURCHASE
  ADJUSTMENT
  WASTAGE
  RETURN
  TRANSFER
}

model InventoryTransaction {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  itemId         String          @map("item_id")
  type           TransactionType
  quantityBefore Decimal         @map("quantity_before") @db.Decimal(12, 3)
  quantityChange Decimal         @map("quantity_change") @db.Decimal(12, 3)
  quantityAfter  Decimal         @map("quantity_after") @db.Decimal(12, 3)
  reason         String?
  actorId        String?         @map("actor_id")
  source         String          @default("web")
  
  // Business specific fields
  clientName     String?         @map("client_name")
  metadata       Json?

  // Guest house: optional link to a booking (for consumption tracking)
  bookingId      String?         @map("booking_id")

  createdAt      DateTime        @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  item         InventoryItem @relation(fields: [itemId], references: [id])
  creditRecord CreditRecord?
  booking      Booking?      @relation(fields: [bookingId], references: [id])

  @@index([organizationId])
  @@index([organizationId, itemId])
  @@index([organizationId, createdAt])
  @@index([bookingId])
  @@map("inventory_transactions")
}

// ── Alert Enums ─────────────────────────────────────────────────
enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AlertType {
  LOW_STOCK
  OUT_OF_STOCK
  DEAD_STOCK
  EXPIRY_RISK
  VARIANCE
  DAILY_INSIGHT
  STAFF_ACTIVITY
}

enum AlertStatus {
  UNRESOLVED
  RESOLVED
  SNOOZED
}

// ── Alerts ───────────────────────────────────────────────────────
model Alert {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  itemId         String?       @map("item_id")
  type           AlertType
  severity       AlertSeverity
  status         AlertStatus   @default(UNRESOLVED)
  title          String
  description    String
  resolvedAt     DateTime?     @map("resolved_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  item          InventoryItem? @relation(fields: [itemId], references: [id])

  @@unique([organizationId, itemId, type], name: "organizationId_itemId_type")
  @@index([organizationId, status])
  @@map("alerts")
}

// ── Push Subscriptions ─────────────────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("push_subscriptions")
}

// ── Business Transactions (Operating expenses & non-inventory income) ──────────

enum BusinessTxType {
  INCOME
  EXPENSE
}

model BusinessTransaction {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  type           BusinessTxType
  category       String         // RENT | SALARY | UTILITIES | LOAN | SUPPLIES | TRANSPORT | MARKETING | TAX | SERVICES | OTHER_EXPENSE | SERVICE_FEE | OTHER_INCOME
  amount         Decimal        @db.Decimal(12, 2)
  description    String?
  staffName      String?        @map("staff_name")   // for SALARY entries
  date           DateTime       @default(now())
  isRecurring    Boolean        @default(false)       @map("is_recurring")
  recurrenceRule String?        @map("recurrence_rule") // MONTHLY | WEEKLY | YEARLY
  createdAt      DateTime       @default(now())       @map("created_at")
  updatedAt      DateTime       @updatedAt            @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, date])
  @@index([organizationId, type])
  @@map("business_transactions")
}

// ── Notes & Scheduling ─────────────────────────────────────────────────────────

enum NoteImportance {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NoteStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model Note {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  authorId       String         @map("author_id")
  title          String
  content        String?        @db.Text
  importance     NoteImportance @default(MEDIUM)
  status         NoteStatus     @default(OPEN)
  dueDate        DateTime?      @map("due_date")
  isPinned       Boolean        @default(false) @map("is_pinned")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id])
  author         User           @relation(fields: [authorId], references: [id])
  checklistItems ChecklistItem[]

  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, importance])
  @@map("notes")
}

model ChecklistItem {
  id          String   @id @default(cuid())
  noteId      String   @map("note_id")
  text        String
  isCompleted Boolean  @default(false) @map("is_completed")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("checklist_items")
}

// ── Credit Management (Accounts Receivable) ────────────────────────────────────

enum CreditStatus {
  UNPAID
  PARTIAL
  PAID
}

model CreditRecord {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  clientName       String       @map("client_name")
  transactionId    String?      @unique @map("transaction_id")
  amountTotal      Decimal      @db.Decimal(12, 2)
  amountPaid       Decimal      @default(0) @db.Decimal(12, 2)
  dueDate          DateTime?    @map("due_date")
  status           CreditStatus @default(UNPAID)
  notes            String?      @db.Text
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  organization     Organization @relation(fields: [organizationId], references: [id])
  transaction      InventoryTransaction? @relation(fields: [transactionId], references: [id])

  @@index([organizationId, status])
  @@map("credit_records")
}

// ── Guest House ─────────────────────────────────────────────────────────────

enum RoomStatus {
  VACANT_CLEAN
  VACANT_DIRTY
  OCCUPIED
  MAINTENANCE
}

model Room {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  name           String
  type           String     // "Single" | "Double" | "Suite" | custom string
  baseRate       Decimal    @map("base_rate") @db.Decimal(12, 2)
  status         RoomStatus @default(VACANT_CLEAN)
  isActive       Boolean    @default(true) @map("is_active")
  notes          String?    @db.Text
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  bookings     Booking[]

  @@index([organizationId])
  @@map("rooms")
}

model Guest {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  phone          String?
  idNumber       String?  @map("id_number")
  email          String?
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  bookings     Booking[]

  @@index([organizationId])
  @@map("guests")
}

enum BookingStatus {
  RESERVED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

model Booking {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  roomId         String        @map("room_id")
  guestId        String        @map("guest_id")
  status         BookingStatus @default(RESERVED)
  checkInDate    DateTime      @map("check_in_date")
  checkOutDate   DateTime      @map("check_out_date")
  actualCheckIn  DateTime?     @map("actual_check_in")
  actualCheckOut DateTime?     @map("actual_check_out")
  ratePerNight   Decimal       @map("rate_per_night") @db.Decimal(12, 2)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id])
  room         Room                   @relation(fields: [roomId], references: [id])
  guest        Guest                  @relation(fields: [guestId], references: [id])
  consumptions InventoryTransaction[]
  invoice      Invoice?

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([roomId, checkInDate, checkOutDate])
  @@map("bookings")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  VOIDED
}

model Invoice {
  id               String        @id @default(cuid())
  organizationId   String        @map("organization_id")
  bookingId        String        @unique @map("booking_id")
  status           InvoiceStatus @default(DRAFT)
  roomTotal        Decimal       @map("room_total") @db.Decimal(12, 2)
  consumptionTotal Decimal       @map("consumption_total") @db.Decimal(12, 2)
  adjustmentsTotal Decimal       @default(0) @map("adjustments_total") @db.Decimal(12, 2)
  amountPaid       Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  issuedAt         DateTime?     @map("issued_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id])
  booking      Booking           @relation(fields: [bookingId], references: [id])
  lineItems    InvoiceLineItem[]
  payments     Payment[]

  @@index([organizationId])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String   @map("invoice_id")
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Payment {
  id         String   @id @default(cuid())
  invoiceId  String   @map("invoice_id")
  amount     Decimal  @db.Decimal(12, 2)
  method     String   // CASH | MPESA | CARD
  note       String?
  recordedAt DateTime @default(now()) @map("recorded_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("payments")
}
