{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@hisaflow/types": ["../../packages/types/src/index.ts"],
      "@hisaflow/theme": ["../../packages/theme/src/index.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": []
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
