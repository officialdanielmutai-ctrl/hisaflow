# HisaFlow frontend environment
#
# Copy to `.env.local` for local development. Never commit real secrets.
# On the host (Vercel or equivalent) set these per environment.

# ── Clerk authentication ───────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── Backend API ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Public domains ─────────────────────────────────────────────────────────
# Canonical origin of the public marketing site (apex). Used for metadata,
# Open Graph, sitemap, robots and structured data. Leave unset locally.
NEXT_PUBLIC_SITE_URL=https://hisaflow.co.ke
# Origin of the authenticated app, when it is served from a subdomain.
# Setting this splits the two hosts: marketing CTAs and sign-in/sign-up point
# at the app origin, and middleware routes app paths to the subdomain. Leave it
# unset for single-origin development and preview builds.
NEXT_PUBLIC_APP_URL=https://app.hisaflow.co.ke

# ── Contact / support (omit to hide the related CTA) ───────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Push notifications ─────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Internal tools ─────────────────────────────────────────────────────────
# The component gallery 404s in production unless this is exactly "true".
NEXT_PUBLIC_ENABLE_GALLERY=false
