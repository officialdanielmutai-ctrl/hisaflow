# ════════════════════════════════════════════════════════════════════════
# Hisaflow LLM Gateway — Required Environment Variables
# Set ALL of these on the Northflank gateway service. The main backend does
# not need provider keys; it only needs LITELLM_BASE_URL and
# LITELLM_MASTER_KEY to call this service.
#
# Northflank runs the slim `app.py` entrypoint on the 512 MB plan. The official
# LiteLLM proxy entrypoint needs ~1 GB and cannot fit beside the API service
# under the free project allowance. Keep the provider keys valid: the gateway
# will fall back across Groq/OpenRouter/Gemini, but an invalid key makes that
# provider fail until it is replaced.
# ════════════════════════════════════════════════════════════════════════

# ── Security ─────────────────────────────────────────────────────────────
# A random secret that guards access to the LiteLLM proxy.
# Generate with: openssl rand -hex 32
# The NestJS backend uses this as its "API key" when calling the gateway.
LITELLM_MASTER_KEY=sk-hisaflow-change-me

# ── AI Provider Keys (Primary Pool) ──────────────────────────────────────
# Validated 2026-11-10: Groq and OpenRouter returned 200. The gateway .env
# Gemini key returned 403, so the backend's valid Gemini key was copied into
# the Northflank service. Re-check keys after rotation.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Avoid a remote model-cost-map fetch on every cold start (lower memory use).
LITELLM_LOCAL_MODEL_COST_MAP=True

# ── AWS Bedrock (Tier 6 — add when ready) ────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── NestJS Backend Connection ─────────────────────────────────────────────
# Set this in the MAIN backend service (not here):
# LITELLM_BASE_URL=https://<your-gateway-service>/v1
# LITELLM_MASTER_KEY=<same value as above>
